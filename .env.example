# Named Cloudflare Zero Trust Tunnel token
CLOUDFLARE_TUNNEL_TOKEN=

# Optional API key protection (leave blank for open board)
# API_KEY_MODE: "writes" (public read, key for mutations/MCP writes) or "all" (key for everything)
API_KEY=
API_KEY_MODE=writes

# Optional Cloudflare Turnstile keys (adaptive human check on add/delete bursts)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional server limits
MAX_TODOS=500
WRITE_LIMIT_PER_MIN=90
